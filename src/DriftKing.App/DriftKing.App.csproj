<Project Sdk="Microsoft.NET.Sdk">

  <!--
    DriftKing as a Windows app: the MatGame shell (WebView2) with the player app embedded (DriftKing.Module/wwwroot) and the offline game
    (DriftKing.Local: the same room, bots and rules on the device). Online it plays against a MatGame master (default MatGameDefaultServer).
    Publish: dotnet publish src/DriftKing.App -c Release -r win-x64 (one self-installing exe, see MatGame.Shell.Installer).
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- builds on the Linux runners too (the solution build); runs on Windows only -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>DriftKing</AssemblyName>
    <RootNamespace>DriftKing.App</RootNamespace>
    <ApplicationIcon>driftking.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="MatGameDefaultServer" Value="$(MatGameDefaultServer)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\MatGame\src\MatGame.Shell\MatGame.Shell.csproj" />
    <ProjectReference Include="..\DriftKing.Local\DriftKing.Local.csproj" />
  </ItemGroup>

  <!-- the player app: DriftKing.Module/wwwroot → web/driftking/... (served at https://driftking.matgame.invalid/driftking/) -->
  <ItemGroup>
    <EmbeddedResource Include="..\DriftKing.Module\wwwroot\**" LogicalName="web/driftking/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <Import Project="..\..\..\MatGame\src\MatGame.Shell\MatGame.Shell.targets" />

</Project>
