@page "/Admin/DriftKing/Players/Edit"
@model DriftKing.Pages.Admin.Players.EditModel
@{
    var p = Model.Player!;
    ViewData["Title"] = p.DisplayName;
    ViewData["PageSub"] = $"Level {Progression.LevelOf(p.Xp)}{(p.IsGuest ? " · Gast" : string.Empty)}";
    ViewData["Crumbs"] = new List<(string, string?)> { ("Administration", "/Admin"), ("DriftKing", "/Admin/DriftKing"), ("Fahrer", "/Admin/DriftKing/Players"), (p.DisplayName, null) };
    ViewData["Width"] = "narrow";
}
<partial name="_Assets" />

<form class="mat-form" method="post" novalidate>
    <partial name="_FormSummary" model="ViewData.ModelState" />

    <div data-tabs>
        <md-tab-group label="Bereiche des Fahrers">
            <md-tab-button panel="player-general" icon="user" active="true">Allgemein</md-tab-button>
            <md-tab-button panel="player-garage" icon="car">Garage</md-tab-button>
            <md-tab-button panel="player-stats" icon="bar-chart">Statistik</md-tab-button>
        </md-tab-group>

        <md-tab-panel id="player-general" active="true">
            <div class="mat-card">
                <div class="mat-card__body mat-form">
                    <md-field name="DisplayName" label="Name" required value="@Model.DisplayName" maxlength="60" hint="Kommt vom MatGame-Konto; beim nächsten Besuch übernimmt DriftKing wieder den Kontonamen." />
                    <div class="mat-grid mat-grid--2">
                        <md-field name="Money" kind="number" label="Geld (Yen)" required value="@Model.Money" min="0" />
                        <md-field name="Xp" kind="number" label="Erfahrung (XP)" required value="@Model.Xp" min="0" hint="@($"Level {Progression.LevelOf(Model.Xp)}")" />
                    </div>
                </div>
            </div>
        </md-tab-panel>

        <md-tab-panel id="player-garage">
            <div class="mat-card">
                @if (Model.Garage.Count == 0)
                {
                    <div class="mat-card__body"><p class="mat-muted">Die Garage ist leer.</p></div>
                }
                else
                {
                    <md-table caption="Garage">
                        <thead>
                            <tr><th scope="col">Auto</th><th scope="col" class="mat-num">Motor</th><th scope="col" class="mat-num">Turbo</th><th scope="col" class="mat-num mat-hide-sm">Fahrwerk</th><th scope="col" class="mat-num mat-hide-sm">Reifen</th><th scope="col" class="mat-num mat-hide-sm">Lenkung</th><th scope="col" class="mat-num">kW</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var g in Model.Garage)
                            {
                                <tr>
                                    <td data-label="Auto"><span class="dk-swatch" style="background:@g.Car.Paint"></span>@g.Car.Name @if (g.Car.Id == p.SelectedGarageCarId) { <span class="mat-pill mat-pill--ok">gewählt</span> }</td>
                                    <td data-label="Motor" class="mat-num mat-mono">@g.Car.Levels.Engine</td>
                                    <td data-label="Turbo" class="mat-num mat-mono">@g.Car.Levels.Turbo</td>
                                    <td data-label="Fahrwerk" class="mat-num mat-mono mat-hide-sm">@g.Car.Levels.Suspension</td>
                                    <td data-label="Reifen" class="mat-num mat-mono mat-hide-sm">@g.Car.Levels.Tires</td>
                                    <td data-label="Lenkung" class="mat-num mat-mono mat-hide-sm">@g.Car.Levels.Steering</td>
                                    <td data-label="kW" class="mat-num mat-mono">@g.Car.Spec.PowerKw</td>
                                </tr>
                            }
                        </tbody>
                    </md-table>
                }
            </div>
        </md-tab-panel>

        <md-tab-panel id="player-stats">
            <div class="mat-card">
                <div class="mat-card__body">
                    <dl class="mat-kv">
                        <dt>Läufe</dt><dd class="mat-mono">@p.RunsPlayed</dd>
                        <dt>Siege</dt><dd class="mat-mono">@p.Wins</dd>
                        <dt>Punkte gesamt</dt><dd class="mat-mono">@Plausibility.Describe(p.TotalScore)</dd>
                        <dt>Bester Lauf</dt><dd class="mat-mono">@Plausibility.Describe(p.BestScore)</dd>
                        <dt>Beste Kette</dt><dd class="mat-mono">@Plausibility.Describe(p.BestCombo)</dd>
                        <dt>Größter Winkel</dt><dd class="mat-mono">@Ui.Number(p.MaxAngle, "0.0")°</dd>
                        <dt>Quer gefahren</dt><dd class="mat-mono">@Ui.Number(p.DriftDistanceM / 1000, "0.00") km</dd>
                        <dt>Dabei seit</dt><dd class="mat-mono">@Ui.Stamp(p.CreateDate)</dd>
                        <dt>Zuletzt</dt><dd class="mat-mono">@Ui.Stamp(p.LastSeenDate)</dd>
                        <dt>Konto-Id</dt><dd class="mat-mono">@p.Id</dd>
                    </dl>
                </div>
            </div>
        </md-tab-panel>
    </div>

    <md-buttons save="Speichern" back="/Admin/DriftKing/Players" delete-handler="Delete" delete-label="Entfernen"
                delete-confirm="@($"„{p.DisplayName}“ aus DriftKing entfernen? Das MatGame-Konto bleibt, aber dieser Fahrer kann DriftKing nicht mehr spielen.")" />
</form>
