<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!--
    DriftKing as a plugin of MatGame (../MatGame): the game API (/driftking/api), the hub (/driftking/hub), the clock of the rooms,
    the database schema "driftking", the admin pages (/Admin/DriftKing/...) and the player app (wwwroot, served at /driftking/).
  -->
  <PropertyGroup>
    <RootNamespace>DriftKing</RootNamespace>
    <AssemblyName>DriftKing.Module</AssemblyName>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    <MatGameWebUsings>true</MatGameWebUsings>
    <StaticWebAssetBasePath>driftking</StaticWebAssetBasePath>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.*" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.*">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\MatGame\src\MatGame.Sdk\MatGame.Sdk.csproj" />
    <ProjectReference Include="..\DriftKing.Core\DriftKing.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DriftKing.Tests" />
  </ItemGroup>

</Project>
